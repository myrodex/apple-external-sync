{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutation batch response",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "status", "results", "submittedAt", "completedAt"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "type": "string", "enum": ["applied", "partial", "rejected", "dry_run"] },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "mutation-result.schema.json" }
    },
    "submittedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "warnings": { "type": "array", "items": { "$ref": "warning.schema.json" }, "maxItems": 64 }
  }
}
