{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task mutation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["listId", "title"],
  "properties": {
    "listId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "notes": { "type": ["string", "null"], "maxLength": 100000 },
    "status": { "type": "string", "enum": ["open", "completed", "cancelled"], "default": "open" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "priority": { "type": "string", "enum": ["none", "low", "medium", "high"], "default": "none" },
    "dueAt": { "type": ["string", "null"], "format": "date-time" },
    "startAt": { "type": ["string", "null"], "format": "date-time" },
    "timeZone": { "type": ["string", "null"], "maxLength": 128 },
    "durationSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 315360000 },
    "url": { "type": ["string", "null"], "format": "uri", "maxLength": 4096 },
    "locationTrigger": { "oneOf": [{ "$ref": "location-trigger.schema.json" }, { "type": "null" }] },
    "recurrence": { "oneOf": [{ "$ref": "recurrence.schema.json" }, { "type": "null" }] },
    "alerts": { "type": "array", "maxItems": 32, "items": { "$ref": "alert.schema.json" } },
    "tags": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "position": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["completedAt"], "properties": { "completedAt": { "type": "string" } } }
    }
  ]
}
