{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutation batch request",
  "description": "Batch operations are processed in order. Unless atomic is true, each operation commits independently and a failed operation does not roll back prior operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "operations"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "mutation.schema.json" }
    },
    "atomic": { "type": "boolean", "default": false },
    "dryRun": { "type": "boolean", "default": false }
  }
}
