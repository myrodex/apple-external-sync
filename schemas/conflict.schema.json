{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimistic concurrency conflict",
  "description": "Returned when If-Match or an expected revision does not match the current canonical resource.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "resourceType", "resourceId", "message", "current", "conflictingFields"],
  "properties": {
    "code": { "const": "conflict" },
    "resourceType": { "type": "string", "enum": ["list", "task"] },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "current": {
      "oneOf": [
        { "$ref": "list.schema.json" },
        { "$ref": "task.schema.json" }
      ]
    },
    "conflictingFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "mergeable": { "type": "boolean" }
  }
}
