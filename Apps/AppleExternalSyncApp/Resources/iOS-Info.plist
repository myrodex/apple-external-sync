<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>External Sync</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>External Sync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>ExternalSyncOAuthRedirectURI</key>
    <string>appleexternalsync://oauth/callback</string>
    <key>ExternalSyncGoogleClientID</key>
    <string>$(EXTERNAL_SYNC_GOOGLE_CLIENT_ID)</string>
    <key>ExternalSyncMicrosoftClientID</key>
    <string>$(EXTERNAL_SYNC_MICROSOFT_CLIENT_ID)</string>
    <key>ExternalSyncRESTBaseURL</key>
    <string>$(EXTERNAL_SYNC_REST_BASE_URL)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>External Sync OAuth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>appleexternalsync</string>
            </array>
        </dict>
    </array>
    <key>NSRemindersUsageDescription</key>
    <string>External Sync reads and updates only the reminder lists you explicitly select.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>External Sync reads and updates only the reminder lists you explicitly select.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>External Sync can notify you when a sync needs attention.</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.myrodex.appleexternalsync.refresh</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
</dict>
</plist>
