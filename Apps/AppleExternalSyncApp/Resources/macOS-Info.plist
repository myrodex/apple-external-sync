<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>External Sync</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>External Sync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>ExternalSyncOAuthRedirectURI</key>
    <string>appleexternalsync://oauth/callback</string>
    <key>ExternalSyncGoogleClientID</key>
    <string>$(EXTERNAL_SYNC_GOOGLE_CLIENT_ID)</string>
    <key>ExternalSyncGoogleAccountID</key>
    <string>$(EXTERNAL_SYNC_GOOGLE_ACCOUNT_ID)</string>
    <key>ExternalSyncMicrosoftClientID</key>
    <string>$(EXTERNAL_SYNC_MICROSOFT_CLIENT_ID)</string>
    <key>ExternalSyncMicrosoftAccountID</key>
    <string>$(EXTERNAL_SYNC_MICROSOFT_ACCOUNT_ID)</string>
    <key>ExternalSyncRESTConfiguration</key>
    <string>$(EXTERNAL_SYNC_REST_CONFIGURATION_JSON)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>External Sync OAuth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>appleexternalsync</string>
            </array>
        </dict>
    </array>
    <key>NSRemindersUsageDescription</key>
    <string>External Sync reads and updates only the reminder lists you explicitly select.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>External Sync reads and updates only the reminder lists you explicitly select.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>External Sync can notify you when a sync needs attention.</string>
</dict>
</plist>
